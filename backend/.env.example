# =============================================
# Summer Academy School — Backend Config
# Copy this file to .env and fill in your values
# =============================================

# Server
PORT=3000

# Email Settings (Gmail example)
# 1. Use your Gmail address
# 2. Enable 2FA on your Google account
# 3. Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-school-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_TO=admin@summeracademy.edu

# School Info
SCHOOL_NAME=Summer Academy School Punjab
